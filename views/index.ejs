<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173f35">
  <title>Automato | Processamento de cursos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --auto-green: #245747;
      --auto-green-dark: #173f35;
      --auto-green-soft: #eaf3ef;
      --auto-ink: #202b26;
      --auto-muted: #68766f;
      --auto-border: #e2e9e4;
      --auto-bg: #f5f7f6;
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      background: var(--auto-bg);
      color: var(--auto-ink);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .topbar {
      background: var(--auto-green-dark);
      color: #fff;
      box-shadow: 0 2px 12px rgba(23, 63, 53, .12);
    }

    .brand-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: rgba(255, 255, 255, .13);
      font-size: 1.3rem;
    }

    .brand-name {
      font-size: 1.12rem;
      font-weight: 750;
      letter-spacing: .01em;
    }

    .brand-caption {
      color: rgba(255, 255, 255, .72);
      font-size: .82rem;
    }

    .page-wrap {
      max-width: 1080px;
    }

    .eyebrow {
      color: var(--auto-green);
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .page-title {
      font-weight: 780;
      letter-spacing: -.035em;
    }

    .page-description {
      max-width: 720px;
      color: var(--auto-muted);
    }

    .panel,
    .info-card {
      background: #fff;
      border: 1px solid var(--auto-border);
      border-radius: 17px;
      box-shadow: 0 10px 30px rgba(28, 45, 38, .045);
    }

    .panel-heading {
      border-bottom: 1px solid #edf1ee;
    }

    .step-number {
      display: inline-flex;
      flex: 0 0 34px;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      color: var(--auto-green);
      background: var(--auto-green-soft);
      font-weight: 800;
    }

    .form-label {
      color: #293831;
      font-size: .93rem;
      font-weight: 650;
    }

    .form-control {
      /* min-height: 48px; */
      border-color: #d6e0d9;
      border-radius: 10px;
    }

    .form-control:focus {
      border-color: #77a492;
      box-shadow: 0 0 0 .22rem rgba(36, 87, 71, .12);
    }

    .upload-zone {
      padding: 18px;
      border: 1px dashed #b9c9c0;
      border-radius: 12px;
      background: #fbfcfb;
    }

    .upload-icon {
      display: inline-flex;
      flex: 0 0 44px;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--auto-green-soft);
      color: var(--auto-green);
      font-size: 1.25rem;
    }

    .helper-text {
      color: var(--auto-muted);
      font-size: .84rem;
      line-height: 1.55;
    }

    .or-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      color: #929f97;
      font-size: .76rem;
      font-weight: 700;
      letter-spacing: .06em;
    }

    .or-divider::before,
    .or-divider::after {
      content: "";
      height: 1px;
      flex: 1;
      background: #e6ebe7;
    }

    .btn-automato {
      min-height: 48px;
      border: 1px solid var(--auto-green);
      border-radius: 10px;
      background: var(--auto-green);
      color: #fff;
      font-weight: 700;
      transition: background .2s;
    }

    .btn-automato:hover,
    .btn-automato:focus {
      background: var(--auto-green-dark);
      color: #fff;
    }

    .btn-automato:disabled {
      opacity: .68;
      cursor: wait;
    }

    .info-card {
      padding: 22px;
    }

    .info-card>.d-flex>i {
      color: var(--auto-green);
      font-size: 1.2rem;
    }

    .progress {
      height: 8px;
      background: #e8eeea;
      border-radius: 20px;
    }

    .progress-bar {
      background: var(--auto-green);
      transition: width .25s ease;
    }

    #status {
      color: var(--auto-muted);
      font-size: .88rem;
    }

    .result-box {
      margin-top: 1.25rem;
      padding: 1.15rem;
      border-radius: 12px;
      overflow-wrap: anywhere;
    }

    .result-box[hidden] {
      display: none !important;
    }

    .result-box.success {
      color: #175b3d;
      background: #edf8f1;
      border: 1px solid #b8e2c7;
    }

    .result-box.error {
      color: #842029;
      background: #fff0f1;
      border: 1px solid #f0c3c7;
    }

    .result-box h2 {
      font-size: 1rem;
      font-weight: 750;
      margin-bottom: .45rem;
    }

    .result-box ul {
      margin: .6rem 0 0;
      padding-left: 1.2rem;
    }

    .result-box li {
      margin-top: .45rem;
      white-space: pre-line;
    }

    .result-box a {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      margin-top: .85rem;
      font-weight: 700;
      color: inherit;
    }

    .footer {
      color: #7a867f;
      font-size: .82rem;
    }

    @media (max-width: 575.98px) {
      .brand-caption {
        display: none;
      }

      .page-title {
        font-size: 1.9rem;
      }

      .panel {
        border-radius: 14px;
      }

      .upload-zone {
        padding: 14px;
      }

      .info-card {
        padding: 18px;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <nav class="navbar navbar-dark py-3">
      <div class="container page-wrap">
        <a class="navbar-brand d-flex align-items-center gap-3 m-0" href="/" aria-label="Automato - início">
          <span class="brand-mark"><i class="bi bi-diagram-3-fill"></i></span>
          <span class="d-flex flex-column">
            <span class="brand-name">Automato</span>
            <span class="brand-caption">Automação de conteúdos educacionais</span>
          </span>
        </a>
        <span
          class="badge rounded-pill text-bg-light bg-opacity-10 border border-light border-opacity-25 text-white px-3 py-2">
          <i class="bi bi-shield-check me-1"></i> Processamento de documentos
        </span>
      </div>
    </nav>
  </header>

  <main class="container page-wrap py-4 py-lg-5">
    <section class="mb-4 mb-lg-5">
      <div class="eyebrow mb-2">Área de trabalho</div>
      <h1 class="page-title display-5 mb-3">Processar conteúdo do curso</h1>
      <p class="page-description fs-6 mb-0">
        Envie um documento Word estruturado para gerar as telas HTML do curso.
        Se preferir, utilize um link compartilhado do OneDrive.
      </p>
    </section>

    <div class="row g-4 align-items-start">
      <div class="col-lg-8">
        <section class="panel overflow-hidden">
          <div class="panel-heading px-4 px-md-5 py-4">
            <div class="d-flex align-items-center gap-3">
              <span class="step-number">1</span>
              <div>
                <h2 class="h5 fw-bold mb-1">Informe o documento</h2>
                <p class="helper-text mb-0">Escolha apenas uma das opções abaixo.</p>
              </div>
            </div>
          </div>

          <form id="uploadForm" class="p-4 p-md-5">
            <div class="mb-4">
              <label for="arquivo" class="form-label d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-word text-success"></i>
                Carregar arquivo do computador
              </label>
              <div class="upload-zone">
                <div class="d-flex align-items-start gap-3 mb-3">
                  <span class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></span>
                  <div>
                    <div class="fw-semibold">Selecione um documento .DOCX</div>
                    <div class="helper-text">Documento Word · Tamanho máximo: 50 MB</div>
                  </div>
                </div>
                <input class="form-control" type="file" name="arquivo" id="arquivo"
                  accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document">
                <div id="fileHelp" class="helper-text mt-2">O documento deve seguir o modelo esperado pela automação.
                </div>
              </div>
            </div>

            <div class="or-divider mb-4"><span>OU UTILIZE UM LINK</span></div>

            <div class="mb-4">
              <label for="documentUrl" class="form-label d-flex align-items-center gap-2">
                <i class="bi bi-link-45deg text-success"></i>
                Link compartilhado do OneDrive
              </label>
              <input class="form-control" type="url" name="documentUrl" id="documentUrl"
                placeholder="https://onedrive.live.com/..." autocomplete="url">
              <div class="helper-text mt-2">
                O link precisa permitir acesso e download do documento. Links privados que exigem autenticação podem não
                funcionar.
              </div>
            </div>

            <div class="d-flex align-items-start gap-2 p-3 rounded-3 mb-4" style="background:#f5f8f6">
              <i class="bi bi-info-circle text-success mt-1"></i>
              <p class="helper-text mb-0">Envie o arquivo ou informe o link — não preencha os dois campos ao mesmo
                tempo.</p>
            </div>

            <button id="submitButton"
              class="btn btn-automato w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
              <i class="bi bi-gear-wide-connected"></i><span>Enviar e processar</span>
            </button>

            <div class="mt-4" aria-label="Progresso do envio">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-semibold">Progresso do envio</span>
                <span id="progressPercent" class="small text-secondary">0%</span>
              </div>
              <div class="progress" role="progressbar" aria-label="Progresso" aria-valuenow="0" aria-valuemin="0"
                aria-valuemax="100">
                <div id="progressBar" class="progress-bar" style="width:0%"></div>
              </div>
              <p id="status" class="mt-2 mb-0" role="status" aria-live="polite"></p>
            </div>

            <section id="resultBox" class="result-box" aria-live="polite" hidden>
              <div class="d-flex align-items-start gap-3">
                <i id="resultIcon" class="bi bi-check-circle-fill fs-4"></i>
                <div class="flex-grow-1">
                  <h2 id="resultTitle"></h2>
                  <p id="resultMessage" class="mb-0"></p>
                  <ul id="errorList" hidden></ul>
                  <a id="outputLink" href="#" target="_blank" rel="noopener noreferrer" hidden><i
                      class="bi bi-box-arrow-up-right"></i> Ver arquivos gerados</a>
                </div>
              </div>
            </section>
          </form>
        </section>
      </div>

      <aside class="col-lg-4">
        <div class="info-card mb-3">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-list-check"></i>
            <h2 class="h6 fw-bold mb-0">Como funciona</h2>
          </div>
          <div class="d-flex gap-3 mb-3">
            <span class="step-number">1</span>
            <div>
              <div class="fw-semibold small">Envie o DOCX</div>
              <p class="helper-text mb-0">Selecione o arquivo ou forneça um link acessível.</p>
            </div>
          </div>
          <div class="d-flex gap-3 mb-3">
            <span class="step-number">2</span>
            <div>
              <div class="fw-semibold small">Aguarde o processamento</div>
              <p class="helper-text mb-0">O sistema analisa a estrutura e os metadados do documento.</p>
            </div>
          </div>
          <div class="d-flex gap-3">
            <span class="step-number">3</span>
            <div>
              <div class="fw-semibold small">Consulte o resultado</div>
              <p class="helper-text mb-0">Quando concluído, utilize o link para acessar os arquivos gerados.</p>
            </div>
          </div>
        </div>

        <div class="info-card">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-shield-lock"></i>
            <h2 class="h6 fw-bold mb-0">Antes de começar</h2>
          </div>
          <ul class="helper-text ps-3 mb-0">
            <li class="mb-2">Confira se o arquivo está no formato .DOCX.</li>
            <li class="mb-2">Verifique se o cabeçalho segue o padrão do projeto.</li>
            <li>Para links, confirme as permissões de acesso.</li>
          </ul>
        </div>
      </aside>
    </div>

    <footer class="footer text-center pt-4 pt-lg-5">
      <span>Automato</span><span class="mx-2">·</span><span>Processamento de conteúdos educacionais</span>
    </footer>
  </main>

  <script>
    const form = document.getElementById('uploadForm');
    const fileInput = document.getElementById('arquivo');
    const documentUrlInput = document.getElementById('documentUrl');
    const progressBar = document.getElementById('progressBar');
    const progressPercent = document.getElementById('progressPercent');
    const progressContainer = progressBar.closest('.progress');
    const status = document.getElementById('status');
    const submitButton = document.getElementById('submitButton');
    const resultBox = document.getElementById('resultBox');
    const resultTitle = document.getElementById('resultTitle');
    const resultMessage = document.getElementById('resultMessage');
    const resultIcon = document.getElementById('resultIcon');
    const errorList = document.getElementById('errorList');
    const outputLink = document.getElementById('outputLink');

    function atualizarProgresso(percentual) {
      const valor = Math.max(0, Math.min(100, percentual));
      progressBar.style.width = valor + '%';
      progressPercent.textContent = valor + '%';
      progressContainer.setAttribute('aria-valuenow', String(valor));
    }

    let intervaloProgresso = null;
    let envioConcluido = false;

    function pararConsultaProgresso() {
      if (intervaloProgresso) {
        clearInterval(intervaloProgresso);
        intervaloProgresso = null;
      }
    }

    function iniciarConsultaProgresso(progressId) {
      pararConsultaProgresso();
      intervaloProgresso = setInterval(async () => {
        try {
          const resposta = await fetch('/progresso/' + encodeURIComponent(progressId), { cache: 'no-store' });
          if (!resposta.ok) return;
          const dados = await resposta.json();
          // O envio ocupa os primeiros 30%; a geração ocupa a faixa seguinte até 99%.
          const percentual = dados.percentual >= 100 ? 99 : Math.round(30 + (Math.max(0, dados.percentual || 0) * 0.69));
          atualizarProgresso(percentual);
          if (dados.etapa) status.textContent = dados.etapa + (dados.percentual >= 100 ? '...' : '...');
          if (dados.concluido) pararConsultaProgresso();
        } catch (_) {
          // Uma falha pontual na consulta não interrompe o processamento.
        }
      }, 500);
    }

    function limparResultado() {
      resultBox.hidden = true;
      resultBox.className = 'result-box';
      resultIcon.className = 'bi fs-4';
      resultTitle.textContent = '';
      resultMessage.textContent = '';
      errorList.replaceChildren();
      errorList.hidden = true;
      outputLink.hidden = true;
      outputLink.removeAttribute('href');
    }

    function mostrarErro(dados, mensagemPadrao) {
      resultBox.hidden = false;
      resultBox.className = 'result-box error';
      resultIcon.className = 'bi bi-exclamation-triangle-fill fs-4';
      resultTitle.textContent = 'Não foi possível processar o documento';
      resultMessage.textContent = dados.message || mensagemPadrao;
      errorList.replaceChildren();

      const erros = Array.isArray(dados.errors) ? dados.errors : [];
      erros.forEach((erro) => {
        const item = document.createElement('li');
        const etapa = erro.etapa ? erro.etapa + ': ' : '';
        item.textContent = etapa + (erro.message || 'Erro não detalhado.');
        errorList.appendChild(item);
      });
      errorList.hidden = erros.length === 0;
    }

    function mostrarSucesso(dados) {
      resultBox.hidden = false;
      resultBox.className = 'result-box success';
      resultIcon.className = 'bi bi-check-circle-fill fs-4';
      resultTitle.textContent = 'Processamento concluído';
      resultMessage.textContent = dados.message || 'Arquivo processado com sucesso.';
      errorList.replaceChildren();
      errorList.hidden = true;

      if (dados.outputUrl) {
        outputLink.href = dados.outputUrl;
        outputLink.hidden = false;
      }
    }

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length) {
        documentUrlInput.value = '';
        document.getElementById('fileHelp').textContent = 'Arquivo selecionado: ' + fileInput.files[0].name;
      } else {
        document.getElementById('fileHelp').textContent = 'O documento deve seguir o modelo esperado pela automação.';
      }
    });

    documentUrlInput.addEventListener('input', () => {
      if (documentUrlInput.value.trim()) fileInput.value = '';
      document.getElementById('fileHelp').textContent = 'O documento deve seguir o modelo esperado pela automação.';
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      limparResultado();
      atualizarProgresso(0);

      const arquivo = fileInput.files[0];
      const documentUrl = documentUrlInput.value.trim();

      if (!arquivo && !documentUrl) {
        mostrarErro({ message: 'Informe o documento que deseja processar.', errors: [{ etapa: 'validação', message: 'Selecione um arquivo DOCX ou informe um link do OneDrive.' }] });
        return;
      }
      if (arquivo && documentUrl) {
        mostrarErro({ message: 'Escolha apenas uma forma de envio.', errors: [{ etapa: 'validação', message: 'Carregue um arquivo ou informe um link, não os dois ao mesmo tempo.' }] });
        return;
      }
      if (arquivo && !arquivo.name.toLowerCase().endsWith('.docx')) {
        mostrarErro({ message: 'Formato de arquivo inválido.', errors: [{ etapa: 'validação', message: 'Selecione um arquivo com extensão .docx.' }] });
        return;
      }

      // Identificador compartilhado entre a interface e o servidor para consultar o progresso.
      const progressId = (window.crypto && typeof window.crypto.randomUUID === 'function')
        ? window.crypto.randomUUID()
        : 'progress-' + Date.now() + '-' + Math.random().toString(16).slice(2);

      const formData = new FormData();
      formData.append('progressId', progressId);
      if (arquivo) formData.append('arquivo', arquivo);
      if (documentUrl) formData.append('documentUrl', documentUrl);

      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/upload', true);
      submitButton.disabled = true;
      submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Processando...</span>';
      status.textContent = arquivo ? 'Enviando documento...' : 'Preparando o download do documento...';
      iniciarConsultaProgresso(progressId);

      xhr.upload.onload = function () { envioConcluido = true; };

      xhr.upload.onprogress = function (e) {
        if (e.lengthComputable) {
          const percent = Math.round((e.loaded / e.total) * 100);
          atualizarProgresso(percent);
          status.textContent = percent < 100 ? 'Enviando documento...' : 'Envio concluído. Processando documento...';
        }
      };

      xhr.onload = function () {
        let dados;
        try {
          dados = JSON.parse(xhr.responseText);
        } catch (erro) {
          dados = { message: 'O servidor retornou uma resposta inesperada.', errors: [{ etapa: 'resposta do servidor', message: 'Tente novamente. Se o erro continuar, consulte o responsável pelo sistema.' }] };
        }

        if (xhr.status >= 200 && xhr.status < 300 && dados.success) {
          atualizarProgresso(100);
          status.textContent = 'Processamento concluído.';
          mostrarSucesso(dados);
        } else {
          status.textContent = 'O processamento encontrou um problema.';
          mostrarErro(dados, 'Ocorreu um erro durante o processamento.');
        }
      };

      xhr.onerror = function () {
        status.textContent = 'Falha na comunicação com o servidor.';
        mostrarErro({ message: 'Não foi possível se comunicar com o servidor.', errors: [{ etapa: 'conexão', message: 'Verifique sua conexão e tente novamente.' }] }, 'Erro de conexão.');
      };

      xhr.onloadend = function () {
        submitButton.disabled = false;
        submitButton.innerHTML = '<i class="bi bi-gear-wide-connected"></i><span>Enviar e processar</span>';
      };

      xhr.send(formData);
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>