<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173f35">
  <title>Automato | Processamento de cursos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --auto-green: #245747;
      --auto-green-dark: #173f35;
      --auto-green-soft: #eaf3ef;
      --auto-ink: #202b26;
      --auto-muted: #68766f;
      --auto-border: #e2e9e4;
      --auto-bg: #f5f7f6;
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      background: var(--auto-bg);
      color: var(--auto-ink);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .topbar {
      background: var(--auto-green-dark);
      color: #fff;
      box-shadow: 0 2px 12px rgba(23, 63, 53, .12);
    }

    .brand-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: rgba(255, 255, 255, .13);
      font-size: 1.3rem;
    }

    .brand-name {
      font-size: 1.12rem;
      font-weight: 750;
      letter-spacing: .01em;
    }

    .brand-caption {
      color: rgba(255, 255, 255, .72);
      font-size: .82rem;
    }

    .page-wrap {
      max-width: 1080px;
    }

    .eyebrow {
      color: var(--auto-green);
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .page-title {
      font-weight: 780;
      letter-spacing: -.035em;
    }

    .page-description {
      max-width: 720px;
      color: var(--auto-muted);
    }

    .panel,
    .info-card {
      background: #fff;
      border: 1px solid var(--auto-border);
      border-radius: 17px;
      box-shadow: 0 10px 30px rgba(28, 45, 38, .045);
    }

    .panel-heading {
      border-bottom: 1px solid #edf1ee;
    }

    .step-number {
      display: inline-flex;
      flex: 0 0 34px;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      color: var(--auto-green);
      background: var(--auto-green-soft);
      font-weight: 800;
    }

    .form-label {
      color: #293831;
      font-size: .93rem;
      font-weight: 650;
    }

    .form-control {
      /* min-height: 48px; */
      border-color: #d6e0d9;
      border-radius: 10px;
    }

    .form-control:focus {
      border-color: #77a492;
      box-shadow: 0 0 0 .22rem rgba(36, 87, 71, .12);
    }

    .upload-zone {
      padding: 18px;
      border: 1px dashed #b9c9c0;
      border-radius: 12px;
      background: #fbfcfb;
    }

    .upload-icon {
      display: inline-flex;
      flex: 0 0 44px;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--auto-green-soft);
      color: var(--auto-green);
      font-size: 1.25rem;
    }

    .helper-text {
      color: var(--auto-muted);
      font-size: .84rem;
      line-height: 1.55;
    }

    .or-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      color: #929f97;
      font-size: .76rem;
      font-weight: 700;
      letter-spacing: .06em;
    }

    .or-divider::before,
    .or-divider::after {
      content: "";
      height: 1px;
      flex: 1;
      background: #e6ebe7;
    }

    .btn-automato {
      min-height: 48px;
      border: 1px solid var(--auto-green);
      border-radius: 10px;
      background: var(--auto-green);
      color: #fff;
      font-weight: 700;
      transition: background .2s;
    }

    .btn-automato:hover,
    .btn-automato:focus {
      background: var(--auto-green-dark);
      color: #fff;
    }

    .btn-automato:disabled {
      opacity: .68;
      cursor: wait;
    }

    .info-card {
      padding: 22px;
    }

    .info-card>.d-flex>i {
      color: var(--auto-green);
      font-size: 1.2rem;
    }

    .progress {
      height: 8px;
      background: #e8eeea;
      border-radius: 20px;
    }

    .progress-bar {
      background: var(--auto-green);
      transition: width .25s ease;
    }

    #status {
      color: var(--auto-muted);
      font-size: .88rem;
    }

    .result-box {
      margin-top: 1.25rem;
      padding: 1.15rem;
      border-radius: 12px;
      overflow-wrap: anywhere;
    }

    .result-box[hidden] {
      display: none !important;
    }

    .result-box.success {
      color: #175b3d;
      background: #edf8f1;
      border: 1px solid #b8e2c7;
    }

    .result-box.error {
      color: #842029;
      background: #fff0f1;
      border: 1px solid #f0c3c7;
    }

    .result-box h2 {
      font-size: 1rem;
      font-weight: 750;
      margin-bottom: .45rem;
    }

    .result-box ul {
      margin: .6rem 0 0;
      padding-left: 1.2rem;
    }

    .result-box li {
      margin-top: .45rem;
      white-space: pre-line;
    }

    .result-box a {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      margin-top: .85rem;
      font-weight: 700;
      color: inherit;
    }

    .footer {
      color: #7a867f;
      font-size: .82rem;
    }

    @media (max-width: 575.98px) {
      .brand-caption {
        display: none;
      }

      .page-title {
        font-size: 1.9rem;
      }

      .panel {
        border-radius: 14px;
      }

      .upload-zone {
        padding: 14px;
      }

      .info-card {
        padding: 18px;
      }
    }
    .files-list-compact { max-height: 190px; overflow-y: auto; border-radius: .5rem; }
    .files-list-compact .list-group-item { padding: .35rem .65rem; font-size: .82rem; line-height: 1.25; }
    #courseLessonSummary .list-group-item { padding: .6rem .8rem; }
    #lessonsList .list-group-item { padding: .65rem .8rem; }
  </style>
</head>

<body>
  <header class="topbar">
    <nav class="navbar navbar-dark py-3">
      <div class="container page-wrap">
        <a class="navbar-brand d-flex align-items-center gap-3 m-0" href="/" aria-label="Automato - início">
          <span class="brand-mark"><i class="bi bi-diagram-3-fill"></i></span>
          <span class="d-flex flex-column">
            <span class="brand-name">Automato</span>
            <span class="brand-caption">Automação de conteúdos educacionais</span>
          </span>
        </a>
        <span
          class="badge rounded-pill text-bg-light bg-opacity-10 border border-light border-opacity-25 text-white px-3 py-2">
          <i class="bi bi-shield-check me-1"></i> Processamento de documentos
        </span>
      </div>
    </nav>
  </header>

  <main class="container page-wrap py-4 py-lg-5">
    <section class="mb-4 mb-lg-5">
      <div class="eyebrow mb-2">Área de trabalho</div>
      <h1 class="page-title display-5 mb-3">Processar conteúdo do curso</h1>
      <p class="page-description fs-6 mb-0">
        Envie um documento Word estruturado para gerar as telas HTML do curso.
        Se preferir, utilize um link compartilhado do OneDrive.
      </p>
    </section>

    <div class="row g-4 align-items-start">
      <div class="col-lg-8">
        <section class="panel overflow-hidden">
          <div class="panel-heading px-4 px-md-5 py-4">
            <div class="d-flex align-items-center gap-3">
              <span class="step-number">1</span>
              <div>
                <h2 class="h5 fw-bold mb-1">Informe o documento</h2>
                <p class="helper-text mb-0">Escolha apenas uma das opções abaixo.</p>
              </div>
            </div>
          </div>

          <form id="uploadForm" class="p-4 p-md-5">
            <div class="mb-4">
              <label for="arquivo" class="form-label d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-word text-success"></i>
                Carregar arquivo do computador
              </label>
              <div class="upload-zone">
                <div class="d-flex align-items-start gap-3 mb-3">
                  <span class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></span>
                  <div>
                    <div class="fw-semibold">Selecione um ou vários documentos .DOCX</div>
                    <div class="helper-text">Documentos Word · Até 20 arquivos, com limite de 50 MB por arquivo</div>
                  </div>
                </div>
                <input class="form-control" type="file" name="arquivos" id="arquivo" multiple
                  accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document">
                <div id="fileHelp" class="helper-text mt-2">O documento deve seguir o modelo esperado pela automação.
                </div>
              </div>
            </div>

            <div class="or-divider mb-4"><span>OU UTILIZE UM LINK</span></div>

            <div class="mb-4">
              <label for="documentUrl" class="form-label d-flex align-items-center gap-2">
                <i class="bi bi-link-45deg text-success"></i>
                Link compartilhado do OneDrive
              </label>
              <input class="form-control" type="url" name="documentUrl" id="documentUrl"
                placeholder="https://onedrive.live.com/..." autocomplete="url">
              <div class="helper-text mt-2">
                O link precisa permitir acesso e download do documento. Links privados que exigem autenticação podem não
                funcionar.
              </div>
            </div>

            <div class="d-flex align-items-start gap-2 p-3 rounded-3 mb-4" style="background:#f5f8f6">
              <i class="bi bi-info-circle text-success mt-1"></i>
              <p class="helper-text mb-0">Envie o arquivo ou informe o link — não preencha os dois campos ao mesmo
                tempo.</p>
            </div>

            <button id="submitButton"
              class="btn btn-automato w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
              <i class="bi bi-gear-wide-connected"></i><span>Enviar e processar</span>
            </button>

            <div class="mt-4" aria-label="Progresso do envio">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-semibold">Progresso do envio</span>
                <span id="progressPercent" class="small text-secondary">0%</span>
              </div>
              <div class="progress" role="progressbar" aria-label="Progresso" aria-valuenow="0" aria-valuemin="0"
                aria-valuemax="100">
                <div id="progressBar" class="progress-bar" style="width:0%"></div>
              </div>
              <p id="status" class="mt-2 mb-0" role="status" aria-live="polite"></p>
            </div>

            <section id="resultBox" class="result-box" aria-live="polite" hidden>
              <div class="d-flex align-items-start gap-3">
                <i id="resultIcon" class="bi bi-check-circle-fill fs-4"></i>
                <div class="flex-grow-1">
                  <h2 id="resultTitle"></h2>
                  <div id="resultMessage" class="mb-0"></div>
                  <ul id="errorList" hidden></ul>
                  <a id="outputLink" href="#" target="_blank" rel="noopener noreferrer" hidden><i
                      class="bi bi-box-arrow-up-right"></i> Ver arquivos gerados</a>
                </div>
              </div>
            </section>
          </form>
        </section>
      </div>

      <aside class="col-lg-4">
        <div class="info-card mb-3">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-list-check"></i>
            <h2 class="h6 fw-bold mb-0">Como funciona</h2>
          </div>
          <div class="d-flex gap-3 mb-3">
            <span class="step-number">1</span>
            <div>
              <div class="fw-semibold small">Envie o DOCX</div>
              <p class="helper-text mb-0">Selecione o arquivo ou forneça um link acessível.</p>
            </div>
          </div>
          <div class="d-flex gap-3 mb-3">
            <span class="step-number">2</span>
            <div>
              <div class="fw-semibold small">Aguarde o processamento</div>
              <p class="helper-text mb-0">O sistema analisa a estrutura e os metadados do documento.</p>
            </div>
          </div>
          <div class="d-flex gap-3">
            <span class="step-number">3</span>
            <div>
              <div class="fw-semibold small">Consulte o resultado</div>
              <p class="helper-text mb-0">Quando concluído, utilize o link para acessar os arquivos gerados.</p>
            </div>
          </div>
        </div>

        <div class="info-card">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-shield-lock"></i>
            <h2 class="h6 fw-bold mb-0">Antes de começar</h2>
          </div>
          <ul class="helper-text ps-3 mb-0">
            <li class="mb-2">Confira se o arquivo está no formato .DOCX.</li>
            <li class="mb-2">Verifique se o cabeçalho segue o padrão do projeto.</li>
            <li>Para links, confirme as permissões de acesso.</li>
          </ul>
        </div>

        <div class="info-card mt-3">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-folder2-open"></i>
            <h2 class="h6 fw-bold mb-0">Gerenciar projetos</h2>
          </div>
          <p class="helper-text mb-3">Gerencie cursos já gerados, lições, estilos e arquivos de áudio.</p>
          <button class="btn btn-automato w-100" type="button" data-bs-toggle="modal" data-bs-target="#projectManagerModal" id="openProjectManager">
            <i class="bi bi-sliders me-2"></i>Abrir gerenciador
          </button>
        </div>
      </aside>
    </div>

    <footer class="footer text-center pt-4 pt-lg-5">
      <span>Automato</span><span class="mx-2">·</span><span>Processamento de conteúdos educacionais</span>
    </footer>
  </main>


  <div class="modal fade" id="projectManagerModal" tabindex="-1" aria-labelledby="projectManagerTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content border-0 rounded-4">
        <div class="modal-header px-4 py-3">
          <div><h2 class="modal-title h5 fw-bold" id="projectManagerTitle">Gerenciador de projetos</h2><p class="helper-text mb-0">Cursos existentes em automato/public</p></div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-4 p-3 rounded-3 bg-light border">
            <label class="form-label fw-semibold" for="selectedProject">Selecione o curso para gerenciar</label>
            <select id="selectedProject" class="form-select"><option value="">Carregando cursos...</option></select>
            <p class="helper-text mt-2 mb-0">As opções de lições, estilos e arquivos serão exibidas depois que você selecionar um curso.</p>
          </div>
          <ul class="nav nav-tabs mb-4" id="projectTabs" role="tablist" hidden>
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabProjects" type="button">Geral</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabLessons" type="button">Lições</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabStyles" type="button">Estilos</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabFiles" type="button">Arquivos</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAudio" type="button"><i class="bi bi-soundwave me-1"></i>Sonorização</button></li>
          </ul>
          <div id="managerNoProject" class="text-center text-muted py-4">Selecione um curso para continuar.</div>
          <div class="tab-content" id="managerTabContent" hidden>
            <section class="tab-pane fade show active" id="tabProjects">
              <div id="selectedProjectSummary" class="list-group"></div>
              <div id="courseLessonSummary" class="mt-3"></div>
              <p class="helper-text mt-3 mb-0">A exclusão remove o curso permanentemente, sem criar cópia de segurança.</p>
            </section>
            <section class="tab-pane fade" id="tabLessons">
              <div id="lessonsList" class="list-group"><div class="text-muted p-3">Carregando lições...</div></div>
            </section>
            <section class="tab-pane fade" id="tabStyles">
              <p class="helper-text">Editando as variáveis de cor de <code>styles/estilos-centralizados.css</code>.</p>
              <div id="styleEditor"><p class="helper-text">Carregando cores...</p></div>
            </section>
            <section class="tab-pane fade" id="tabFiles">
              <div id="fileEditorWrap" class="mb-3" hidden><label class="form-label fw-semibold" id="editingFileLabel">Arquivo</label><textarea id="fileEditor" class="form-control font-monospace" rows="14" spellcheck="false"></textarea><button id="saveFile" class="btn btn-automato mt-2">Salvar arquivo</button></div>
              <div id="filesList" class="list-group files-list-compact"><div class="text-muted p-3">Carregando arquivos...</div></div>
            </section>
            <section class="tab-pane fade" id="tabAudio">
              <div class="text-center py-4 px-3">
                <i class="bi bi-soundwave display-4 text-success"></i>
                <h5 class="mt-3">Sonorização dos conteúdos</h5>
                <p class="text-muted mx-auto" style="max-width:620px">No futuro, você poderá gerar arquivos MP3 para os conteúdos deste curso usando uma API de síntese de voz. Nenhum áudio será gerado nesta versão.</p>
                <button id="askGenerateAudio" type="button" class="btn btn-automato"><i class="bi bi-music-note-beamed me-2"></i>Gostaria de gerar os áudios?</button>
                <p id="audioFutureStatus" class="helper-text mt-3 mb-0" role="status" aria-live="polite"></p>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('uploadForm');
    const fileInput = document.getElementById('arquivo');
    const documentUrlInput = document.getElementById('documentUrl');
    const progressBar = document.getElementById('progressBar');
    const progressPercent = document.getElementById('progressPercent');
    const progressContainer = progressBar.closest('.progress');
    const status = document.getElementById('status');
    const submitButton = document.getElementById('submitButton');
    const resultBox = document.getElementById('resultBox');
    const resultTitle = document.getElementById('resultTitle');
    const resultMessage = document.getElementById('resultMessage');
    const resultIcon = document.getElementById('resultIcon');
    const errorList = document.getElementById('errorList');
    const outputLink = document.getElementById('outputLink');

    function atualizarProgresso(percentual) {
      const valor = Math.max(0, Math.min(100, percentual));
      progressBar.style.width = valor + '%';
      progressPercent.textContent = valor + '%';
      progressContainer.setAttribute('aria-valuenow', String(valor));
    }

    let intervaloProgresso = null;
    let envioConcluido = false;

    function pararConsultaProgresso() {
      if (intervaloProgresso) {
        clearInterval(intervaloProgresso);
        intervaloProgresso = null;
      }
    }

    function iniciarConsultaProgresso(progressId) {
      pararConsultaProgresso();
      intervaloProgresso = setInterval(async () => {
        try {
          const resposta = await fetch('/progresso/' + encodeURIComponent(progressId), { cache: 'no-store' });
          if (!resposta.ok) return;
          const dados = await resposta.json();
          // O envio ocupa os primeiros 30%; a geração ocupa a faixa seguinte até 99%.
          const percentual = dados.percentual >= 100 ? 99 : Math.round(30 + (Math.max(0, dados.percentual || 0) * 0.69));
          atualizarProgresso(percentual);
          if (dados.etapa) status.textContent = dados.etapa + (dados.percentual >= 100 ? '...' : '...');
          if (dados.concluido) pararConsultaProgresso();
        } catch (_) {
          // Uma falha pontual na consulta não interrompe o processamento.
        }
      }, 500);
    }

    function limparResultado() {
      resultBox.hidden = true;
      resultBox.className = 'result-box';
      resultIcon.className = 'bi fs-4';
      resultTitle.textContent = '';
      resultMessage.textContent = '';
      errorList.replaceChildren();
      errorList.hidden = true;
      outputLink.hidden = true;
      outputLink.removeAttribute('href');
    }

    function mostrarErro(dados, mensagemPadrao) {
      resultBox.hidden = false;
      resultBox.className = 'result-box error';
      resultIcon.className = 'bi bi-exclamation-triangle-fill fs-4';
      resultTitle.textContent = 'Não foi possível processar o documento';
      resultMessage.textContent = dados.message || mensagemPadrao;
      errorList.replaceChildren();

      const erros = Array.isArray(dados.errors) ? dados.errors : [];
      erros.forEach((erro) => {
        const item = document.createElement('li');
        const etapa = erro.etapa ? erro.etapa + ': ' : '';
        item.textContent = etapa + (erro.message || 'Erro não detalhado.');
        errorList.appendChild(item);
      });
      errorList.hidden = erros.length === 0;
    }

    function mostrarSucesso(dados) {
      resultBox.hidden = false;
      resultBox.className = 'result-box success';
      resultIcon.className = 'bi bi-check-circle-fill fs-4';
      resultTitle.textContent = dados.totalDocumentos > 1 ? 'Processamento em lote concluído' : 'Processamento concluído';
      resultMessage.textContent = dados.message || 'Arquivo(s) processado(s) com sucesso.';
      if (Array.isArray(dados.resultados) && dados.resultados.length) {
        const lista = document.createElement('ul');
        lista.className = 'mt-3 mb-0';
        dados.resultados.forEach(item => {
          const linha = document.createElement('li');
          linha.textContent = `${item.numeroLicao ? 'Lição ' + item.numeroLicao + ' — ' : ''}${item.nomeArquivo}: ${item.success ? 'gerada com sucesso' : 'falha: ' + (item.message || 'erro não identificado')}`;
          lista.appendChild(linha);
        });
        resultMessage.appendChild(lista);
      }
      errorList.replaceChildren();
      errorList.hidden = true;

      if (dados.outputUrl) {
        outputLink.href = dados.outputUrl;
        outputLink.hidden = false;
      }
    }

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length) {
        documentUrlInput.value = '';
        const nomes = Array.from(fileInput.files).map(f => f.name);
        document.getElementById('fileHelp').textContent = `${nomes.length} arquivo(s) selecionado(s): ${nomes.join(', ')}`;
      } else {
        document.getElementById('fileHelp').textContent = 'O documento deve seguir o modelo esperado pela automação.';
      }
    });

    documentUrlInput.addEventListener('input', () => {
      if (documentUrlInput.value.trim()) fileInput.value = '';
      document.getElementById('fileHelp').textContent = 'O documento deve seguir o modelo esperado pela automação.';
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      limparResultado();
      atualizarProgresso(0);

      const arquivos = Array.from(fileInput.files || []);
      const documentUrl = documentUrlInput.value.trim();

      if (!arquivos.length && !documentUrl) {
        mostrarErro({ message: 'Informe os documentos que deseja processar.', errors: [{ etapa: 'validação', message: 'Selecione um ou mais arquivos DOCX ou informe um link do OneDrive.' }] });
        return;
      }
      if (arquivos.length && documentUrl) {
        mostrarErro({ message: 'Escolha apenas uma forma de envio.', errors: [{ etapa: 'validação', message: 'Carregue um arquivo ou informe um link, não os dois ao mesmo tempo.' }] });
        return;
      }
      const arquivoInvalido = arquivos.find(arquivo => !arquivo.name.toLowerCase().endsWith('.docx'));
      if (arquivoInvalido) {
        mostrarErro({ message: 'Formato de arquivo inválido.', errors: [{ etapa: 'validação', message: `O arquivo ${arquivoInvalido.name} não possui extensão .docx.` }] });
        return;
      }
      if (arquivos.length > 20) {
        mostrarErro({ message: 'Quantidade de arquivos excedida.', errors: [{ etapa: 'validação', message: 'Selecione no máximo 20 documentos por envio.' }] });
        return;
      }

      // Identificador compartilhado entre a interface e o servidor para consultar o progresso.
      const progressId = (window.crypto && typeof window.crypto.randomUUID === 'function')
        ? window.crypto.randomUUID()
        : 'progress-' + Date.now() + '-' + Math.random().toString(16).slice(2);

      const formData = new FormData();
      formData.append('progressId', progressId);
      arquivos.forEach(arquivo => formData.append('arquivos', arquivo));
      if (documentUrl) formData.append('documentUrl', documentUrl);

      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/upload', true);
      submitButton.disabled = true;
      submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Processando...</span>';
      status.textContent = arquivos.length ? `Enviando ${arquivos.length} documento(s)...` : 'Preparando o download do documento...';
      iniciarConsultaProgresso(progressId);

      xhr.upload.onload = function () { envioConcluido = true; };

      xhr.upload.onprogress = function (e) {
        if (e.lengthComputable) {
          const percent = Math.round((e.loaded / e.total) * 100);
          atualizarProgresso(percent);
          status.textContent = percent < 100 ? 'Enviando documentos...' : 'Envio concluído. Ordenando e processando lições...';
        }
      };

      xhr.onload = function () {
        let dados;
        try {
          dados = JSON.parse(xhr.responseText);
        } catch (erro) {
          dados = { message: 'O servidor retornou uma resposta inesperada.', errors: [{ etapa: 'resposta do servidor', message: 'Tente novamente. Se o erro continuar, consulte o responsável pelo sistema.' }] };
        }

        if (xhr.status >= 200 && xhr.status < 300 && dados.success) {
          atualizarProgresso(100);
          status.textContent = 'Processamento concluído.';
          mostrarSucesso(dados);
        } else {
          status.textContent = 'O processamento encontrou um problema.';
          mostrarErro(dados, 'Ocorreu um erro durante o processamento.');
        }
      };

      xhr.onerror = function () {
        status.textContent = 'Falha na comunicação com o servidor.';
        mostrarErro({ message: 'Não foi possível se comunicar com o servidor.', errors: [{ etapa: 'conexão', message: 'Verifique sua conexão e tente novamente.' }] }, 'Erro de conexão.');
      };

      xhr.onloadend = function () {
        submitButton.disabled = false;
        submitButton.innerHTML = '<i class="bi bi-gear-wide-connected"></i><span>Enviar e processar</span>';
      };

      xhr.send(formData);
    });
  </script>

  <script>
    (() => {
      const $ = id => document.getElementById(id);
      let projects = [];
      let selectedProject = '';
      let currentFile = '';
      const safe = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      async function api(url, options={}) {
        const response = await fetch(url, { headers: {'Content-Type':'application/json', ...(options.headers||{})}, ...options });
        const data = await response.json().catch(()=>({message:'Resposta inválida do servidor.'}));
        if (!response.ok) throw new Error(data.message || 'Não foi possível concluir a operação.');
        return data;
      }
      function projectUrl(suffix='') { return '/api/projects/'+encodeURIComponent(selectedProject)+suffix; }
      async function loadProjects() {
        try {
          const data = await api('/api/projects'); projects = data.projects || [];
          const select = $('selectedProject'), previous = selectedProject;
          select.innerHTML = '<option value="">Selecione um curso...</option>' + projects.map(p=>`<option value="${safe(p.name)}">${safe(p.name)}</option>`).join('');
          if (projects.some(p=>p.name===previous)) { select.value=previous; await chooseProject(previous); }
          else { selectedProject=''; select.value=''; showManager(false); }
        } catch(e) { $('managerNoProject').innerHTML=`<div class="alert alert-danger">${safe(e.message)}</div>`; }
      }
      function showManager(show) {
        $('projectTabs').hidden = !show;
        $('managerTabContent').hidden = !show;
        $('managerNoProject').hidden = show;
        if (!show) $('managerNoProject').textContent='Selecione um curso para continuar.';
      }
      async function chooseProject(name) {
        selectedProject = name || '';
        if (!selectedProject) { showManager(false); return; }
        showManager(true);
        const p = projects.find(item=>item.name===selectedProject);
        $('selectedProjectSummary').innerHTML = p ? `<div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3"><div><div class="fw-semibold">Curso: ${safe(p.name)}</div><div class="helper-text">${p.lessons} arquivo(s) HTML · ${p.files} arquivo(s) editável(is)</div></div><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-success" href="${safe(p.url)}" target="_blank" rel="noopener">Abrir curso</a><button class="btn btn-sm btn-outline-danger" id="deleteSelectedProject">Excluir curso</button></div></div>` : '';
        $('courseLessonSummary').innerHTML = '<div class="text-muted small">Carregando informações das lições...</div>';
        $('deleteSelectedProject').addEventListener('click', async()=>{
          if(!confirm(`Excluir o curso "${selectedProject}" permanentemente? Não será criada cópia de segurança.`)) return;
          try { const d=await api(projectUrl(),{method:'DELETE'}); alert(d.message); selectedProject=''; await loadProjects(); }
          catch(e){alert(e.message);}
        });
        $('audioFutureStatus').textContent='';
        await Promise.all([loadLessons(),loadStyles(),loadFiles()]);
      }
      $('openProjectManager').addEventListener('click',loadProjects);
      $('selectedProject').addEventListener('change',e=>chooseProject(e.target.value));
      async function loadLessons(){
        if(!selectedProject)return;
        try {
          const d=await api(projectUrl('/lessons'));
          $('lessonsList').innerHTML=d.lessons.length?d.lessons.map(l=>`<div class="list-group-item d-flex justify-content-between align-items-center gap-3"><div class="text-break"><div class="fw-semibold">${safe(l.nome)}</div><div class="helper-text">Pasta: ${safe(l.path)}</div><div class="helper-text">${l.totalTelas} tela(s) cadastrada(s) · ${l.count} arquivo(s) HTML</div></div><button class="btn btn-sm btn-outline-danger flex-shrink-0" data-delete-lesson="${safe(l.path)}">Excluir</button></div>`).join(''):'<div class="p-3 text-muted">Nenhuma lição HTML encontrada.</div>';
          $('courseLessonSummary').innerHTML = `<div class="d-flex justify-content-between align-items-center mb-2"><h6 class="mb-0">${safe(d.courseName || selectedProject)}</h6><span class="badge text-bg-secondary">${d.lessons.length} lição(ões)</span></div>` + (d.lessons.length ? `<div class="list-group">${d.lessons.map(l=>`<div class="list-group-item"><div class="fw-semibold">${safe(l.nome)}</div><div class="helper-text">${safe(l.totalTelas)} tela(s) · ${safe(l.path)}</div></div>`).join('')}</div>` : '<p class="text-muted small mb-0">Nenhuma lição encontrada.</p>');
        }
        catch(e){$('lessonsList').innerHTML=`<div class="alert alert-danger">${safe(e.message)}</div>`;}
      }
      $('lessonsList').addEventListener('click',async e=>{const b=e.target.closest('[data-delete-lesson]');if(!b)return;const lessonPath=b.dataset.deleteLesson;if(!confirm(`Excluir esta lição?
${lessonPath}`))return;try{await api(projectUrl('/lessons'),{method:'DELETE',body:JSON.stringify({path:lessonPath})});await loadLessons();}catch(err){alert(err.message);}});
      async function loadStyles(){
        if(!selectedProject)return;
        try {
          const d=await api(projectUrl('/styles'));
          if(!d.variables.length){$('styleEditor').innerHTML='<p class="helper-text">Não encontrei variáveis de cor no bloco :root de styles/estilos-centralizados.css.</p>';return;}
          $('styleEditor').innerHTML=d.variables.map((v,i)=>`<div class="row align-items-center g-2 mb-3"><div class="col-md-5"><label class="form-label mb-0" for="cssvar${i}">${safe(v.name)}</label><div class="small text-muted">${safe(v.value)}</div></div><div class="col-4 col-md-3"><input type="color" class="form-control form-control-color" id="cssvar${i}" value="${/^#[0-9a-f]{6}$/i.test(v.value)?v.value:'#245747'}" data-var="${safe(v.name)}" aria-label="Selecionar cor de ${safe(v.name)}"></div><div class="col-8 col-md-4"><input class="form-control form-control-sm" value="${safe(v.value)}" data-var-text="${safe(v.name)}" aria-label="Valor CSS de ${safe(v.name)}"></div></div>`).join('')+'<button id="saveStyles" class="btn btn-automato mt-2">Salvar alterações no CSS</button><span id="styleStatus" class="helper-text ms-3" role="status"></span>';
          $('styleEditor').querySelectorAll('[data-var]').forEach(el=>el.addEventListener('input',()=>{const t=$('styleEditor').querySelector(`[data-var-text="${el.dataset.var}"]`);if(t)t.value=el.value;}));
          $('styleEditor').querySelectorAll('[data-var-text]').forEach(el=>el.addEventListener('change',()=>{const c=$('styleEditor').querySelector(`[data-var="${el.dataset.varText}"]`);if(c&&/^#[0-9a-f]{6}$/i.test(el.value))c.value=el.value;}));
          $('saveStyles').addEventListener('click',async()=>{const variables=[...$('styleEditor').querySelectorAll('[data-var-text]')].map(el=>({name:el.dataset.varText,value:el.value}));try{const result=await api(projectUrl('/styles'),{method:'PUT',body:JSON.stringify({variables})});$('styleStatus').textContent=result.message;}catch(e){$('styleStatus').textContent=e.message;}});
        } catch(e){$('styleEditor').innerHTML=`<div class="alert alert-danger">${safe(e.message)}</div>`;}
      }
      async function loadFiles(){
        if(!selectedProject)return;
        $('fileEditorWrap').hidden=true;
        try { const d=await api(projectUrl('/files')); $('filesList').innerHTML=d.files.length?d.files.map(f=>`<button class="list-group-item list-group-item-action" data-open-file="${safe(f.path)}"><i class="bi bi-file-earmark-code me-2"></i>${safe(f.path)}</button>`).join(''):'<div class="p-3 text-muted">Nenhum arquivo HTML, CSS ou JS encontrado.</div>'; }
        catch(e){$('filesList').innerHTML=`<div class="alert alert-danger">${safe(e.message)}</div>`;}
      }
      $('filesList').addEventListener('click',async e=>{const b=e.target.closest('[data-open-file]');if(!b)return;try{const d=await api(projectUrl('/file?path='+encodeURIComponent(b.dataset.openFile)));currentFile=d.path;$('editingFileLabel').textContent=d.path;$('fileEditor').value=d.content;$('fileEditorWrap').hidden=false;$('filesList').querySelectorAll('[data-open-file]').forEach(item=>item.classList.toggle('active',item===b));}catch(err){alert(err.message);}});
      $('saveFile').addEventListener('click',async()=>{try{const d=await api(projectUrl('/file'),{method:'PUT',body:JSON.stringify({path:currentFile,content:$('fileEditor').value})});alert(d.message);}catch(e){alert(e.message);}});
      $('askGenerateAudio').addEventListener('click',()=>{const wantsAudio=confirm(`Gostaria de gerar os áudios do curso "${selectedProject}"?`);if(wantsAudio){$('audioFutureStatus').textContent='Funcionalidade planejada. A geração será conectada a uma API em uma etapa futura; nenhum áudio foi gerado.';}else{$('audioFutureStatus').textContent='Tudo bem. Você poderá solicitar a geração dos áudios quando essa funcionalidade estiver disponível.';}});
    })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>