<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173f35">
  <title>Biblioteca de Componentes - Automato</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/biblioteca.css">
</head>

<body>
  <header class="topbar">
    <nav class="navbar navbar-dark py-3">
      <div class="container page-wrap">
        <a class="navbar-brand d-flex align-items-center gap-3 m-0" href="/">
          <span class="brand-mark"><i class="bi bi-diagram-3-fill"></i></span>
          <span class="d-flex flex-column">
            <span class="brand-name">Automato</span>
            <span class="brand-caption">Biblioteca de componentes</span>
          </span>
        </a>
        <div class="topbar-nav" aria-label="Navegação principal">
          <a class="topbar-link" href="/">
            <i class="bi bi-file-earmark-arrow-up"></i><span>Processar</span>
          </a>
          <a class="topbar-link" href="/gerenciar">
            <i class="bi bi-folder2-open"></i><span>Gerenciar</span>
          </a>
          <a class="topbar-link is-active" href="/biblioteca" aria-current="page">
            <i class="bi bi-collection"></i><span>Biblioteca</span>
          </a>
          <a class="topbar-link is-disabled" aria-disabled="true" tabindex="-1"
            title="Editor temporariamente desabilitado" aria-label="Editor temporariamente desabilitado">
            <i class="bi bi-code-square"></i><span>Editor</span>
          </a>
        </div>
      </div>
    </nav>
  </header>

  <main class="container page-wrap py-4 py-lg-5">
    <div class="library-heading mb-4">
      <div class="eyebrow mb-2">Referência para roteiros</div>
      <h1 class="page-title display-5 mb-2">Biblioteca de componentes</h1>
      <p class="page-description mb-3">Consulte os componentes disponíveis no Automato. Cada cartão apresenta uma
        representação visual simplificada e permite copiar a tabela do componente já formatada para o roteiro.</p>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-automato" href="/modelo-roteiro-docx"><i class="bi bi-file-earmark-word me-2"></i>Baixar
          modelo de roteiro DOCX</a>
        <a class="btn btn-outline-success" href="#componentes"><i class="bi bi-grid me-2"></i>Ver componentes</a>
      </div>
    </div>

    <section class="library-guide mb-4">
      <div class="d-flex gap-3 align-items-start">
        <i class="bi bi-info-circle-fill fs-4"></i>
        <div>
          <h2 class="h6 fw-bold mb-1">Como utilizar</h2>
          <p class="small mb-0">Clique em <strong>Copiar tabela</strong> no componente desejado e cole no roteiro DOCX.
            Depois, substitua os textos de exemplo pelo conteúdo da aula.</p>
        </div>
      </div>
    </section>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3" id="componentes">
      <div>
        <h2 class="h4 fw-bold mb-1">Componentes disponíveis</h2>
        <p class="helper-text mb-0">
          <%= componentes.length %> componentes cadastrados no sistema
        </p>
      </div>
      <div class="library-search">
        <i class="bi bi-search"></i>
        <input type="search" id="componentSearch" class="form-control" placeholder="Buscar componente..."
          aria-label="Buscar componente">
      </div>
    </div>

    <div class="row g-3" id="componentGrid">
      <% componentes.forEach((componente)=> { %>
        <div class="col-sm-6 col-xl-4 component-column"
          data-search="<%= (componente.nome + ' ' + componente.descricao).toLowerCase() %>">
          <article class="component-card h-100">
            <div class="component-preview preview-<%= componente.slug %>" aria-hidden="true">
              <div class="preview-canvas">
                <% if (componente.slug==='imagem' ) { %>
                  <figure class="mock-imagem">
                    <span class="mock-imagem-titulo">Título opcional</span>
                    <span class="mock-imagem-foto"><i class="bi bi-image" aria-hidden="true"></i></span>
                    <span class="mock-imagem-rodape">Rodapé opcional</span>
                  </figure>
                <% } else if (componente.slug==='destaque' ) { %>
                  <div class="mock-destaque" role="note">
                    <b>Atenção</b>
                    <span>Confira os equipamentos de proteção antes de iniciar.</span>
                  </div>
                <% } else if (componente.slug==='dividir' ) { %>
                  <div class="mock-dividir">
                    <div class="mock-dividir-coluna">
                      <span>ANTES</span><i></i><i></i>
                    </div>
                    <div class="mock-dividir-marcador" aria-hidden="true"></div>
                    <div class="mock-dividir-coluna">
                      <span>DEPOIS</span><i></i><i></i>
                    </div>
                  </div>
                  <% } else if (componente.slug==='botao' || componente.slug==='botaotela' ) { %>
                  <div class="mock-botao-demo">
                    <div class="mock-botao-demo-fundo">
                      <div class="mock-heading"></div>
                      <div class="mock-line wide"></div>
                      <div class="mock-line"></div>
                      <span class="mock-button">Abrir janela</span>
                    </div>
                    <div class="mock-botao-janela" aria-hidden="true">
                      <div class="mock-botao-janela-topo"><b>Janela</b><i class="bi bi-x-lg"></i></div>
                      <div class="mock-line wide"></div>
                      <div class="mock-line mid"></div>
                    </div>
                  </div>
                  <% } else if (componente.slug==='hotword' ) { %>
                    <div class="mock-line wide"></div>
                    <div class="mock-line"><span class="mock-highlight">palavra-chave<span class="mock-popover" aria-hidden="true"><b>Explicação</b><i class="mock-popover-linha wide"></i><i class="mock-popover-linha"></i></span></span></div>
                    <div class="mock-line mid"></div>
                      <% } else if (componente.slug==='flashcard' ) { %>
                      <div class="mock-flash">
                        <div class="mock-flash-inner">
                          <div class="mock-flash-face mock-flash-front"><span>FRENTE</span><strong>Conceito</strong><small>↻</small></div>
                          <div class="mock-flash-face mock-flash-back"><span>VERSO</span><strong>Definição</strong></div>
                        </div>
                      </div>
                      <% } else if (componente.slug==='jogomemoria' ) { %>
                        <div class="mock-jogomemoria">
                          <div class="mock-jogomemoria-card fechado"><span class="mock-jogomemoria-face mock-jogomemoria-verso">✦</span><span class="mock-jogomemoria-face mock-jogomemoria-frente">Maçã</span></div>
                          <div class="mock-jogomemoria-card aberto"><span class="mock-jogomemoria-face mock-jogomemoria-verso">✦</span><span class="mock-jogomemoria-face mock-jogomemoria-frente">Maçã</span></div>
                          <div class="mock-jogomemoria-card aberto"><span class="mock-jogomemoria-face mock-jogomemoria-verso">✦</span><span class="mock-jogomemoria-face mock-jogomemoria-frente">Fruta</span></div>
                          <div class="mock-jogomemoria-card fechado"><span class="mock-jogomemoria-face mock-jogomemoria-verso">✦</span><span class="mock-jogomemoria-face mock-jogomemoria-frente">Fruta</span></div>
                          <div class="mock-jogomemoria-feedback"><i class="bi bi-check-circle-fill"></i> Par encontrado!</div>
                        </div>
                        <% } else if (componente.slug==='abas' ) { %>
                          <div class="mock-tabs"><span class="active">Aba 1</span><span>Aba 2</span><span>Aba 3</span>
                          </div>
                          <div class="mock-panel">
                            <div class="mock-line wide"></div>
                            <div class="mock-line mid"></div>
                          </div>
                          <% } else if (componente.slug==='opcoes' ) { %>
                            <div class="mock-opcoes">
                              <span class="mock-opcoes-item"><i aria-hidden="true"></i>Alternativa A</span>
                              <span class="mock-opcoes-item"><i aria-hidden="true"></i>Alternativa B</span>
                              <span class="mock-opcoes-item"><i aria-hidden="true"></i>Alternativa C</span>
                              <span class="mock-opcoes-submit">Submeter</span>
                              <div class="mock-opcoes-feedback"><b>Resposta correta</b><span>Parabéns!</span></div>
                            </div>
                            <% } else if (componente.slug==='verdadeirofalso' ) { %>
                              <div class="mock-verdadeirofalso">
                                <div><span class="mock-vf-campo">V</span><span>O céu é azul?</span></div>
                                <div><span class="mock-vf-campo">F</span><span>A Terra é plana?</span></div>
                                <div class="mock-vf-botao">Submeter</div>
                                <div class="mock-vf-feedback"><b>Resposta enviada</b><span>Muito bem!</span></div>
                              </div>
                              <% } else if (componente.slug==='forca' ) { %>
                                <div class="mock-forca">
                                  <div class="mock-forca-palavra" aria-hidden="true">
                                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                                  </div>
                                  <div class="mock-forca-teclado" aria-hidden="true">
                                    <div>Q W E R T Y U I O P</div>
                                    <div>A S D F G H J K L</div>
                                    <div>Z X C V B N M</div>
                                  </div>
                                  <svg class="mock-forca-desenho" viewBox="0 0 60 70" aria-hidden="true">
                                    <path class="mock-forca-estrutura" d="M5 65H55M14 65V6H43V14"></path>
                                    <circle class="mock-forca-boneco-cabeca" cx="43" cy="22" r="6"></circle>
                                    <path class="mock-forca-boneco-corpo" d="M43 28V44M43 32L34 41M43 32L52 41M43 44L35 57M43 44L51 57"></path>
                                  </svg>
                                </div>
                                <% } else if (componente.slug==='relacionarcolunas' ) { %>
                                  <div class="mock-relacionarcolunas">
                                    <div class="mock-rc-coluna">
                                      <span><b>A</b><i>Maçã</i></span>
                                      <span><b>B</b><i>Banana</i></span>
                                    </div>
                                    <div class="mock-rc-coluna mock-rc-respostas">
                                      <span><em>A</em><i>Vermelha</i></span>
                                      <span><em>B</em><i>Amarela</i></span>
                                    </div>
                                    <div class="mock-rc-submeter">Submeter</div>
                                    <div class="mock-rc-feedback"><i class="bi bi-check-circle-fill"></i><span>Associações conferidas!</span></div>
                                  </div>
                                  <% } else if (componente.slug==='audio' ) { %>
                                    <div class="mock-audio"><i class="bi bi-play-fill"></i>
                                      <div><b></b><span></span></div><small>00:35</small>
                                    </div>
                                    <% } else if (componente.slug==='video' ) { %>
                                      <div class="mock-video">
                                        <div class="mock-video-player"><i class="bi bi-play-circle-fill"></i><span>VÍDEO</span></div>
                                        <div class="mock-video-controls"><i class="bi bi-play-fill"></i><b></b><small>02:14</small></div>
                                        <div class="mock-video-button"><i class="bi bi-play-fill"></i> Assistir vídeo</div>
                                      </div>
                                      <% } else if (componente.slug==='arquivo' ) { %>
                                        <div class="mock-arquivo">
                                          <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                                          <span>Abrir pdf</span>
                                          <i class="bi bi-box-arrow-up-right mock-arquivo-externo" aria-hidden="true"></i>
                                        </div>
                                    <% } else if (componente.slug==='textocomimagem' ) { %>
                                      <div class="mock-image"></div>
                                      <div class="mock-text">
                                        <div class="mock-line wide"></div>
                                        <div class="mock-line"></div>
                                        <div class="mock-line mid"></div>
                                      </div>
                                      <% } else if (componente.slug==='mininavegacao' ) { %>
                                        <div class="mock-mini-nav">
                                          <span class="mock-mini-control mock-mini-back" aria-hidden="true">&lsaquo;</span>
                                          <div class="mock-mini-window">
                                            <div class="mock-mini-window-heading"><span class="mock-mini-etapa-indicador"><b class="etapa-um">Etapa 1</b><b class="etapa-dois">Etapa 2</b></span><small>de 2</small></div>
                                            <div class="mock-mini-window-content">
                                              <div class="mock-mini-etapa mock-mini-conteudo-um"><span>Conceito básico</span><i class="mock-line wide"></i><i class="mock-line mid"></i></div>
                                              <div class="mock-mini-etapa mock-mini-conteudo-dois"><span>Exemplo prático</span><i class="mock-line wide"></i><i class="mock-line mid"></i></div>
                                            </div>
                                          </div>
                                          <span class="mock-mini-control mock-mini-next" aria-hidden="true">&rsaquo;</span>
                                        </div>
                                        <% } else if (componente.slug==='sanfona' ) { %>
                                          <div class="mock-accordion">
                                            <div class="mock-accordion-item"><span>Painel 1</span><i
                                                class="bi bi-chevron-down"></i></div>
                                            <div class="mock-accordion-content">
                                              <div class="mock-line wide"></div>
                                              <div class="mock-line mid"></div>
                                            </div>
                                            <div class="mock-accordion-item"><span>Painel 2</span><i
                                                class="bi bi-chevron-down"></i></div>
                                            <div class="mock-accordion-item"><span>Painel 3</span><i
                                                class="bi bi-chevron-down"></i></div>
                                          </div>
                                          <% } else if (componente.slug==='exercitando' ) { %>
                                            <div class="mock-heading"></div>
                                            <div class="mock-question">Qual alternativa está correta?</div>
                                            <div class="mock-option">○ Alternativa A</div>
                                            <div class="mock-option">○ Alternativa B</div>
                                            <% } else if (componente.slug==='ligapontos' ) { %>
                                              <div class="mock-ligapontos">
                                                <div class="mock-ligapontos-col">
                                                  <b>Opções</b>
                                                  <div><span>Opção 1</span><i></i></div>
                                                  <div><span>Opção 2</span><i></i></div>
                                                  <div><span>Opção 3</span><i></i></div>
                                                  <div><span>Opção 4</span><i></i></div>
                                                  <div><span>Opção 5</span><i></i></div>
                                                </div>
                                                <div class="mock-ligapontos-col mock-ligapontos-respostas">
                                                  <b>Respostas</b>
                                                  <div><i></i><span>Resposta 1</span></div>
                                                  <div><i></i><span>Resposta 2</span></div>
                                                  <div><i></i><span>Resposta 3</span></div>
                                                  <div><i></i><span>Resposta 4</span></div>
                                                  <div><i></i><span>Resposta 5</span></div>
                                                </div>
                                                <svg class="mock-ligapontos-svg" viewBox="0 0 100 100"
                                                  preserveAspectRatio="none" aria-hidden="true">
                                                  <path d="M 43 20 C 48 27, 52 43, 57 50"></path>
                                                  <path d="M 43 35 C 49 43, 51 65, 57 80"></path>
                                                  <path d="M 43 50 C 49 42, 51 28, 57 20"></path>
                                                  <path d="M 43 65 C 49 57, 51 43, 57 35"></path>
                                                  <path d="M 43 80 C 49 73, 51 58, 57 65"></path>
                                                </svg>
                                              </div>
                                              <% } else if (componente.slug==='apresentacao' ||
                                                componente.slug==='introducao' || componente.slug==='fechamento' ) { %>
                                                <div class="mock-cover-icon"><i class="bi <%= componente.icone %>"></i>
                                                </div>
                                                <div class="mock-heading"></div>
                                                <div class="mock-line wide"></div>
                                                <div class="mock-line mid"></div>
                                                <% } else if (componente.slug==='objetivos' ) { %>
                                                  <div class="mock-heading"></div>
                                                  <div class="mock-objective">✓ <span></span></div>
                                                  <div class="mock-objective">✓ <span></span></div>
                                                  <div class="mock-objective">✓ <span></span></div>
                                                  <% } else if (componente.slug==='capitulo' ) { %>
                                                    <div class="mock-chapter"><small>CAPÍTULO</small><strong>01</strong>
                                                    </div>
                                                    <div class="mock-line wide"></div>
                                                    <% } else if (componente.slug==='importante' ) { %>
                                                      <div class="mock-alert"><i
                                                          class="bi bi-exclamation-circle-fill"></i>
                                                        <div><b>Importante</b><span></span><span></span></div>
                                                      </div>
                                                      <% } else if (componente.slug==='saibamais' ) { %>
                                                        <div class="mock-more"><i class="bi bi-lightbulb-fill"></i>
                                                          <div><b>Saiba mais</b><span></span><span></span></div>
                                                        </div>
                                                        <% } else { %>
                                                          <div class="mock-heading"></div>
                                                          <div class="mock-line wide"></div>
                                                          <div class="mock-line"></div>
                                                          <div class="mock-line mid"></div>
                                                          <div class="mock-line wide"></div>
                                                          <% } %>
              </div>
            </div>
            <div class="p-3 p-lg-4 d-flex flex-column flex-grow-1">
              <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <h3 class="h5 fw-bold mb-0">
                  <%= componente.nome %>
                </h3>
                <span class="component-tag">
                  <%= componente.slug %>
                </span>
              </div>
              <p class="helper-text mb-3 flex-grow-1">
                <%= componente.descricao %>
              </p>
              <button class="btn btn-outline-success copy-component w-100" type="button"
                data-component="<%= componente.slug %>">
                <i class="bi bi-clipboard me-2"></i>Copiar tabela
              </button>
            </div>
          </article>
        </div>
        <% }) %>
    </div>
    <p id="emptySearch" class="text-center helper-text py-5" hidden>Nenhum componente encontrado.</p>

    <footer class="footer text-center">
      <span>Automato - Vando Pinto</span><span class="mx-2">·</span><a
        href="mailto:vandopintoo@gmail.com">vandopintoo@gmail.com</a>
    </footer>
  </main>

  <div class="copy-feedback" id="copyFeedback" role="status" aria-live="polite"><i
      class="bi bi-check-circle-fill me-2"></i>Tabela copiada!</div>
  <script>
    window.componentTableExamples = <%- JSON.stringify(estruturasTabela || {}) %>;
  </script>
  <script src="/assets/js/atualizacao-global.js"></script>
  <script src="/assets/js/component-table-transfer.js"></script>
  <script src="/assets/js/biblioteca.js"></script>
</body>

</html>
