<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0f3b2f">
  <title>Gerenciador de projetos | Automato · NT Educação</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/views/partials/ui.css">
</head>

<body data-manager-only="true" class="manager-only">
  <header class="app-header">
    <div class="shell app-header__inner">
      <a class="brand" href="/" aria-label="Automato — início">
        <span class="brand__mark"><i class="bi bi-diagram-3-fill"></i></span>
        <span class="brand__text">
          <span class="brand__name">Automato</span>
          <span class="brand__caption">NT Educação · automação de conteúdos</span>
        </span>
      </a>

      <nav class="app-header__nav" aria-label="Navegação principal">
        <a class="nav-link-top" href="/">
          <i class="bi bi-magic"></i><span>Processar</span>
        </a>
        <a class="nav-link-top is-active" href="/gerenciar" aria-current="page">
          <i class="bi bi-kanban"></i><span>Gerenciar</span>
        </a>
        <a class="nav-link-top" href="/biblioteca">
          <i class="bi bi-grid-1x2"></i><span>Biblioteca</span>
        </a>
      </nav>
    </div>
  </header>

  <main class="shell page">
    <section class="page-hero">
      <span class="eyebrow"><i class="bi bi-kanban"></i> Área de gestão</span>
      <h1 class="page-title">Gerenciador de <em>projetos</em>.</h1>
      <p class="page-description">Escolha um curso para revisar lições, ajustar a paleta, gerar a sonorização e publicar o pacote final.</p>
    </section>

  <div class="manager-shell" id="projectManagerModal" tabindex="-1" aria-labelledby="projectManagerTitle">
    <section class="card card--upload manager-card">
      <div class="dropzone__header manager-card__header">
        <span class="step-chip"><i class="bi bi-folder2-open"></i></span>
        <div class="dropzone__heading">
          <h2 id="projectManagerTitle" class="dropzone__heading-title">Selecione o curso</h2>
          <p class="dropzone__heading-sub">Cursos existentes em <code>automato/public</code></p>
        </div>
        <span class="head-badge"><i class="bi bi-database"></i> PROJETOS</span>
      </div>

      <div class="card__body">
        <div class="project-picker">
          <div class="project-picker__field">
            <label class="form-label" for="selectedProject">Curso para gerenciar</label>
            <select id="selectedProject" class="form-select">
              <option value="">Carregando cursos...</option>
            </select>
          </div>

          <button id="refreshProjects" type="button" class="btn btn-outline-success w-100">
            <i class="bi bi-arrow-clockwise"></i><span>Atualizar lista de cursos</span>
          </button>
          <p class="helper-text mb-0">As opções de lições, estilos e arquivos serão exibidas depois que você
            selecionar um curso.</p>
        </div>

        <ul class="tabs" id="projectTabs" role="tablist" hidden>
            <li class="tabs__item"><button class="tab-link active" data-bs-toggle="tab" data-bs-target="#tabProjects"
                type="button"><i class="bi bi-info-circle"></i>Geral</button></li>
            <li class="tabs__item"><button class="tab-link" data-bs-toggle="tab" data-bs-target="#tabLessons"
                type="button"><i class="bi bi-journal-text"></i>Lições</button></li>
            <li class="tabs__item"><button class="tab-link" data-bs-toggle="tab" data-bs-target="#tabStyles"
                type="button"><i class="bi bi-palette"></i>Estilos</button></li>
            <!-- Mantida no código para possível reativação, mas oculta da interface. -->
            <li class="tabs__item" hidden><button class="tab-link" id="filesTabButton" data-bs-toggle="tab"
                data-bs-target="#tabFiles" type="button" role="tab" aria-controls="tabFiles" aria-selected="false"><i
                  class="bi bi-code-square me-1"></i>Gerenciar arquivos</button></li>
            <li class="tabs__item"><button class="tab-link" data-bs-toggle="tab" data-bs-target="#tabAudio"
                type="button"><i class="bi bi-soundwave"></i>Sonorização</button></li>
            <li class="tabs__item"><button class="tab-link" id="publishTabButton" data-bs-toggle="tab"
                data-bs-target="#tabPublish" type="button" role="tab" aria-controls="tabPublish" aria-selected="false"><i
                  class="bi bi-box-arrow-up me-1"></i>Publicar</button></li>
          </ul>
          <div id="managerNoProject" class="manager-empty" hidden></div>
          <div class="tab-content" id="managerTabContent" hidden>
            <section class="tab-pane fade show active" id="tabProjects">
              <div id="selectedProjectSummary" class="list-group"></div>
              <div id="courseLessonSummary" class="mt-3"></div>
              <p class="helper-text mt-3 mb-0">A exclusão remove o curso permanentemente, sem criar cópia de segurança.
              </p>
            </section>
            <section class="tab-pane fade" id="tabLessons">
              <div id="lessonsList" class="list-group">
                <div class="text-muted p-3">Carregando lições...</div>
              </div>
            </section>
            <section class="tab-pane fade" id="tabStyles">
              <p class="helper-text">Editando as variáveis de cor de <code>styles/estilos-centralizados.css</code>.</p>
              <div id="styleEditor">
                <p class="helper-text">Carregando cores...</p>
              </div>
            </section>
            <section class="tab-pane fade" id="tabPublish" role="tabpanel" aria-labelledby="publishTabButton">
              <div class="publish-shell">
                <header class="publish-hero">
                  <div class="publish-hero-icon" aria-hidden="true"><i class="bi bi-box-seam-fill"></i></div>
                  <div>
                    <span class="publish-eyebrow">Preparar entrega</span>
                    <h3>Publicar curso</h3>
                    <p>Configure a entrega e gere o pacote para disponibilização no Discent.</p>
                  </div>
                  <div class="publish-hero-badge"><i class="bi bi-shield-check"></i> Avant ativo</div>
                </header>

                <div class="publish-content">
                  <div class="publish-notice" role="alert">
                    <span class="publish-notice-icon" aria-hidden="true"><i class="bi bi-info-circle-fill"></i></span>
                    <p><strong>Publicação exclusiva para Discent.</strong> Será gerado um arquivo ZIP do curso
                      selecionado com a comunicação com o Avant ativada. Esse pacote não funciona quando aberto fora
                      do Discent.</p>
                  </div>

                  <ol class="publish-flow" aria-label="Etapas da publicação">
                    <li><span>1</span><div><strong>Curso</strong><small>Selecione o material</small></div></li>
                    <li><span>2</span><div><strong>Cores</strong><small>Defina a paleta</small></div></li>
                    <li><span>3</span><div><strong>ZIP</strong><small>Baixe para publicar</small></div></li>
                  </ol>

                  <div class="publish-course-selected">
                    <span class="publish-course-icon" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                    <div>
                      <small>CURSO PARA PUBLICAÇÃO</small>
                      <span id="publishProjectName">Selecione um curso para habilitar a publicação.</span>
                      <em id="publishProjectMeta">Aguardando a seleção de um curso.</em>
                    </div>
                  </div>

                  <fieldset class="publish-layouts">
                    <legend>
                      <span>Escolha uma paleta de cores</span>
                      <small>As opções alteram as cores do curso; a estrutura de navegação é mantida.</small>
                    </legend>
                    <div class="row g-3" role="radiogroup" aria-label="Layout para publicação">
                      <div class="col-md-4">
                        <input class="btn-check" type="radio" name="publishLayout" id="publishLayout1" value="azul" checked>
                        <label class="publish-layout-card publish-theme-blue" for="publishLayout1">
                          <span class="publish-layout-preview" aria-hidden="true">
                            <i></i><b></b><b></b><b></b>
                          </span>
                          <span class="publish-layout-copy"><strong class="fw-semibold">Azul institucional</strong><small>Tom sóbrio e profissional</small></span>
                          <span class="publish-layout-check"><i class="bi bi-check-lg"></i></span>
                        </label>
                      </div>
                      <div class="col-md-4">
                        <input class="btn-check" type="radio" name="publishLayout" id="publishLayout2" value="verde">
                        <label class="publish-layout-card publish-theme-green" for="publishLayout2">
                          <span class="publish-layout-preview" aria-hidden="true">
                            <i></i><b></b><b></b><b></b>
                          </span>
                          <span class="publish-layout-copy"><strong class="fw-semibold">Verde natural</strong><small>Tom leve e acolhedor</small></span>
                          <span class="publish-layout-check"><i class="bi bi-check-lg"></i></span>
                        </label>
                      </div>
                      <div class="col-md-4">
                        <input class="btn-check" type="radio" name="publishLayout" id="publishLayout3" value="roxo">
                        <label class="publish-layout-card publish-theme-purple" for="publishLayout3">
                          <span class="publish-layout-preview" aria-hidden="true">
                            <i></i><b></b><b></b><b></b>
                          </span>
                          <span class="publish-layout-copy"><strong class="fw-semibold">Roxo contemporâneo</strong><small>Tom criativo e marcante</small></span>
                          <span class="publish-layout-check"><i class="bi bi-check-lg"></i></span>
                        </label>
                      </div>
                    </div>
                  </fieldset>

                  <footer class="publish-action-bar">
                    <div><strong>Pronto para publicar?</strong><span>O arquivo ZIP será preparado para o Discent.</span></div>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                      <button id="publishCourse" type="button" class="btn btn-automato" disabled aria-disabled="true">
                        <i class="bi bi-file-earmark-zip me-2"></i>Publicar e gerar ZIP
                      </button>
                      <span id="publishStatus" class="helper-text" role="status" aria-live="polite">Em breve.</span>
                    </div>
                  </footer>
                </div>
              </div>
            </section>
            <section class="tab-pane fade" id="tabFiles" role="tabpanel" aria-labelledby="filesTabButton" hidden>
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                  <h5 class="h6 fw-bold mb-1">Arquivos do curso</h5>
                  <p class="helper-text mb-0">Abra e edite HTML, CSS e JavaScript. Os grupos começam recolhidos; escolha
                    qual deseja abrir.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span id="projectStatus" class="helper-text" role="status" aria-live="polite"></span>
                  <button id="refreshFiles" type="button" class="btn btn-sm btn-outline-secondary"><i
                      class="bi bi-arrow-clockwise me-1"></i>Atualizar</button>
                </div>
              </div>
              <section class="files-workspace">
                <div class="files-browser">
                  <div class="files-browser-heading">
                    <div class="fw-semibold"><i class="bi bi-folder2-open me-2"></i>Arquivos do curso</div>
                    <div class="helper-text">Arquivos HTML agrupados por lição quando os metadados estão disponíveis;
                      CSS e JavaScript ficam em grupos próprios. Todos os grupos começam fechados.</div>
                  </div>
                  <div id="filesList">
                    <div class="text-muted p-3">Selecione um curso.</div>
                  </div>
                </div>
                <div class="file-editor-panel">
                  <div class="file-editor-heading">
                    <div class="fw-semibold"><i class="bi bi-code-square me-2"></i>Editor de código</div>
                    <div id="editingFileLabel" class="helper-text text-break">Selecione um arquivo na lista</div>
                  </div>
                  <div id="fileEditorWrap" hidden>
                    <div id="fileEditor" aria-label="Editor de código" role="region"></div>
                    <textarea id="fileEditorFallback" class="form-control font-monospace" spellcheck="false"
                      aria-label="Conteúdo do arquivo" hidden></textarea>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                      <button id="saveFile" class="btn btn-automato" disabled><i class="bi bi-save me-2"></i>Salvar
                        alterações</button>
                      <span id="fileSaveStatus" class="helper-text" role="status" aria-live="polite"></span>
                    </div>
                  </div>
                  <div id="fileEditorEmpty" class="file-editor-empty">
                    <div><i class="bi bi-file-earmark-code display-5 d-block mb-3"></i>
                      <div class="fw-semibold mb-1">Nenhum arquivo selecionado</div>
                      <div>Escolha um arquivo à esquerda para editar seu conteúdo.</div>
                    </div>
                  </div>
                </div>
              </section>
            </section>
            <section class="tab-pane fade" id="tabAudio">
              <div class="py-4 px-3">
                <div class="text-center mb-4">
                  <i class="bi bi-soundwave display-4 text-success"></i>
                  <h5 class="mt-3">Sonorização dos conteúdos</h5>
                  <p class="text-muted mx-auto" style="max-width:680px">Gere os MP3 a partir do arquivo
                    <code>som/sonorizacao.json</code>. A síntese Piper acontece no navegador; os arquivos prontos
                    são gravados na pasta <code>som/&lt;sigla da lição&gt;/</code> do curso.
                  </p>
                </div>
                <div class="row g-3 align-items-end">
                  <div class="col-md-5">
                    <label class="form-label fw-semibold" for="audioGenerationMode">O que deseja gerar?</label>
                    <select id="audioGenerationMode" class="form-select">
                      <option value="all">Todas as lições (em sequência)</option>
                      <option value="single">Somente uma lição</option>
                    </select>
                  </div>
                  <div class="col-md-4" id="audioLessonField" hidden>
                    <label class="form-label fw-semibold" for="audioLessonSelect">Lição</label>
                    <select id="audioLessonSelect" class="form-select">
                      <option value="">Carregando lições...</option>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label fw-semibold" for="audioVoice">Voz Piper</label>
                    <select id="audioVoice" class="form-select">
                      <option value="pt_BR-faber-medium" selected>Português (Brasil) — Faber (média)</option>
                    </select>
                  </div>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center mt-4">
                  <button id="askGenerateAudio" type="button" class="btn btn-automato">
                    <i class="bi bi-music-note-beamed"></i><span>Gerar som</span>
                  </button>
                  <button id="cancelGenerateAudio" type="button" class="btn btn-danger-soft" hidden>
                    <i class="bi bi-stop-circle"></i><span>Cancelar geração</span>
                  </button>
                  <span id="audioFutureStatus" class="helper-text" role="status" aria-live="polite"></span>
                </div>
                <div id="audioProgressWrap" class="mt-3" hidden>
                  <div class="d-flex justify-content-between gap-2 mb-1">
                    <span id="audioProgressLabel" class="small">Preparando...</span>
                    <span id="audioProgressPercent" class="small fw-semibold">0%</span>
                  </div>
                  <div class="progress" role="progressbar" aria-label="Progresso da geração de áudios" aria-valuemin="0"
                    aria-valuemax="100" aria-valuenow="0">
                    <div id="audioProgressBar" class="progress-bar" style="width:0%"></div>
                  </div>
                  <div id="audioGenerationLog" class="small mt-3" aria-live="polite"></div>
                </div>
              </div>
            </section>
          </div>
      </div>
    </section>
  </div>
  </main>

  <footer class="app-footer">
    <div class="shell app-footer__inner">
      <span><strong>Automato</strong> · NT Educação</span>
      <span>Gerenciador de projetos</span>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/atualizacao-global.js"></script>
  <script src="/assets/js/gerenciar.js"></script>
</body>

</html>
